        autoBatEnabled = v
        autoBatToken += 1
        local myToken = autoBatToken
        if v then
            task.spawn(function()
                while autoBatEnabled and autoBatToken == myToken do
                    local c, h = getCC()
                    local bat = getBat()
                    if c and h and h.Health > 0 and bat then
                        if bat.Parent ~= c then pcall(function() h:EquipTool(bat) end) end
                        if bat.Parent == c then pcall(function() bat:Activate() end) end
                    end
                    task.wait(BAT_INTERVAL)
                end
            end)
        end
    end,
})

