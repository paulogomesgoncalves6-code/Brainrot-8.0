local Menu = Armenta.Menu({
    Title = "X HUB Mobile",
    Theme = "Crimson",
    Size = UDim2.fromOffset(560, 460),
    Resizable = true,
    Shadow = true,
    HasOutline = true,
})

-- Constants
local DISCORD_URL = "https://discord.gg/DBZQ7pqwx"
local MUSIC_ID = "rbxassetid://97825347303470"
local AURA_SPEED = 60
local FOLLOW_DIST = 4
local BAT_INTERVAL = 0.6
local JUMP_HEIGHT = 5
local CARRY_SPEED = 29
local NORMAL_SPEED = 59
local LIFT_STUDS = 8
local ESP_RAINBOW_SPEED = 0.35
local ESP_DETECT_RANGE = 20

-- State
local currentSpeed = nil
local floatEnabled, floatConn = false, nil
local autoBatEnabled, autoBatToken = false, 0
local auraEnabled, auraToken = false, 0
local antiResetEnabled, antiResetConn = false, nil
local antiLagEnabled = false
local espEnabled = false
local espObjects = {}
local speedMode, liftPad, liftConn, slowAnimConn = nil, nil, nil, nil
local infiniteJumpEnabled, jumpDebounce = false, false
local antiRagdollEnabled, ragdollConn = false, nil
local ragdollAnchor, ragdollPos, ragdollWas = nil, nil, false

-- Helpers
local function notify(title, content, notifType)
    pcall(function()
        Menu:Notify({ Title = title, Content = content, Type = notifType or "Info", Duration = 4 })
    end)
end

local function getCC()
    local c = player.Character
    if not c then return nil, nil, nil end
    return c, c:FindFirstChildOfClass("Humanoid"), c:FindFirstChild("HumanoidRootPart")
end

local function getBat()
    local c = player.Character
    local bp = player:FindFirstChildOfClass("Backpack")
    local b = c and c:FindFirstChild("Bat")
    if b and b:IsA("Tool") then return b end
    b = bp and bp:FindFirstChild("Bat")
    if b and b:IsA("Tool") then return b end
    return nil
end

local function equipBat()
    local c, h = getCC()
    local b = getBat()
    if c and h and b and b.Parent ~= c then
        pcall(function() h:EquipTool(b) end)
    end
    return b
end

local function setSpeed(s)
    currentSpeed = s
    local _, h = getCC()
    if h and not auraEnabled then h.WalkSpeed = s or 16 end
end
