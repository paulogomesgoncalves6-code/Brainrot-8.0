        "https://raw.githubusercontent.com/Xyraniz/VaultUI/refs/heads/main/Libraries/Armenta-Lib/source.lua"
    ))()
end)
if not ok or not Armenta then
    warn("X HUB: falha ao carregar Armenta-Lib")
