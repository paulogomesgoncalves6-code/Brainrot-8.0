--==================================================
-- ANTI RESET (funções base)
--==================================================
function applyResetBlock()
    if not antiResetEnabled then return end
    pcall(function() StarterGui:SetCore("ResetButtonCallback", false) end)
end

--==================================================
-- ANTI LAG
--==================================================
local antiLagBackup = { fov = 70, lighting = {}, particles = {} }

local function applyAntiLag()
    if antiLagEnabled then return end
    antiLagEnabled = true

    local cam = workspace.CurrentCamera
    if cam then
        antiLagBackup.fov = cam.FieldOfView
        cam.FieldOfView = 90
    end

    -- Remove animações do player
    local char = player.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        local anim = hum and hum:FindFirstChildOfClass("Animator")
        if anim then
            for _, track in ipairs(anim:GetPlayingAnimationTracks()) do
                pcall(function() track:Stop() end)
            end
        end
    end

    if antiLagBackup.animConn then antiLagBackup.animConn:Disconnect() end
    antiLagBackup.animConn = RunService.Heartbeat:Connect(function()
        if not antiLagEnabled then return end
        local _, h = getCC()
        local anim = h and h:FindFirstChildOfClass("Animator")
        if not anim then return end
        for _, tr in ipairs(anim:GetPlayingAnimationTracks()) do
            local a = tr.Animation
            if a then
                local n = string.lower(tr.Name .. " " .. a.Name)
                if string.find(n, "walk") or string.find(n, "run")
                or string.find(n, "idle") or string.find(n, "jump")
                or string.find(n, "fall") or string.find(n, "climb") then
                    tr:AdjustSpeed(0)
                end
            end
        end
    end)

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ParticleEmitter") or obj:IsA("Fire")
        or obj:IsA("Smoke") or obj:IsA("Sparkles")
        or obj:IsA("Trail") or obj:IsA("Beam") then
            pcall(function()
                if obj.Enabled then
                    table.insert(antiLagBackup.particles, obj)
                    obj.Enabled = false
                end
            end)
        end
    end

    for _, l in ipairs(Lighting:GetChildren()) do
        if l:IsA("PostEffect") or l:IsA("Atmosphere")
        or l:IsA("BloomEffect") or l:IsA("BlurEffect")
        or l:IsA("SunRaysEffect") or l:IsA("ColorCorrectionEffect")
        or l:IsA("DepthOfFieldEffect") then
            pcall(function()
                if l.Enabled then
                    antiLagBackup.lighting[l] = true
                    l.Enabled = false
                end
            end)
        end
    end

    notify("X HUB", "Anti Lag ON", "Success")
end

local function removeAntiLag()
    if not antiLagEnabled then return end
    antiLagEnabled = false

    local cam = workspace.CurrentCamera
    if cam then cam.FieldOfView = antiLagBackup.fov end

    if antiLagBackup.animConn then
        antiLagBackup.animConn:Disconnect()
        antiLagBackup.animConn = nil
    end

    for _, obj in ipairs(antiLagBackup.particles) do
        pcall(function()
            if obj and obj.Parent then obj.Enabled = true end
        end)
    end
    table.clear(antiLagBackup.particles)

    for effect in pairs(antiLagBackup.lighting) do
        pcall(function()
            if effect and effect.Parent then effect.Enabled = true end
        end)
    end
    table.clear(antiLagBackup.lighting)

    notify("X HUB", "Anti Lag OFF", "Info")
end

