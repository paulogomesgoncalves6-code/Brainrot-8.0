local function createBeam(rot, trans)
    local b = Instance.new("Frame")
    b.Size = UDim2.fromScale(1, 1)
    b.BackgroundColor3 = Color3.fromRGB(255, 20, 20)
    b.BackgroundTransparency = trans
    b.BorderSizePixel = 0
    b.ZIndex = 11
    b.Parent = beamLayer
    local g = Instance.new("UIGradient")
    g.Rotation = rot
    g.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(90, 0, 0)),
        ColorSequenceKeypoint.new(0.35, Color3.fromRGB(255, 0, 0)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 220, 220)),
        ColorSequenceKeypoint.new(0.65, Color3.fromRGB(255, 0, 0)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(90, 0, 0)),
    })
    g.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 1),
        NumberSequenceKeypoint.new(0.5, 0),
        NumberSequenceKeypoint.new(1, 1),
    })
    g.Parent = b
    task.spawn(function()
        while b.Parent do
            local t = TweenService:Create(g, TweenInfo.new(2.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Offset = Vector2.new(0.8, 0)})
            t:Play(); t.Completed:Wait()
            if not b.Parent then break end
            local t2 = TweenService:Create(g, TweenInfo.new(2.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Offset = Vector2.new(-0.8, 0)})
            t2:Play(); t2.Completed:Wait()
        end
    end)
end
