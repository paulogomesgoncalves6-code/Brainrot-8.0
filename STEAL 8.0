local PlayerTab = Menu:Tab({ Text = "Player", Icon = "user" })

PlayerTab:BoldLabel({ Text = "Speed", Description = "Levita 8 studs + animação zerada" })

PlayerTab:Toggle({
    Text = "Carry speed (29)",
    Description = "Levita 8 studs + speed 29 + animação zerada",
    Default = false,
    Callback = function(v)
        if v then
            speedMode = CARRY_SPEED
            setSpeed(CARRY_SPEED)
            applySpeedEffects()
        elseif speedMode == CARRY_SPEED then
            speedMode = nil
            setSpeed(nil)
            applySpeedEffects()
        end
    end,
})

PlayerTab:Toggle({
    Text = "Normal speed (59)",
    Description = "Levita 8 studs + speed 59 + animação zerada",
    Default = false,
    Callback = function(v)
        if v then
            speedMode = NORMAL_SPEED
            setSpeed(NORMAL_SPEED)
            applySpeedEffects()
        elseif speedMode == NORMAL_SPEED then
            speedMode = nil
            setSpeed(nil)
            applySpeedEffects()
        end
    end,
})

PlayerTab:Button({
    Text = "Restaurar Speed",
    Icon = "rotate-ccw",
    Callback = function()
        speedMode = nil
        setSpeed(nil)
        applySpeedEffects()
        notify("X HUB", "Speed restaurado", "Info")
    end,
})

PlayerTab:Divider()
PlayerTab:BoldLabel({ Text = "Movimento" })

PlayerTab:Toggle({
    Text = "Float",
    Description = "Voa e desce rápido",
    Default = false,
    Callback = function(v)
        floatEnabled = v
        if floatConn then floatConn:Disconnect(); floatConn = nil end
        if v then
            floatConn = RunService.Heartbeat:Connect(function()
                if not floatEnabled or speedMode or auraEnabled then return end
                local _, h, root = getCC()
                if not h or not root or h.Health <= 0 then return end
                h.WalkSpeed = 28
                if h.FloorMaterial == Enum.Material.Air then
                    local vel = root.AssemblyLinearVelocity
                    if vel.Y < 0 then
                        root.AssemblyLinearVelocity = Vector3.new(vel.X, math.max(vel.Y - 4, -120), vel.Z)
                    end
                end
            end)
        end
    end,
})

PlayerTab:Toggle({
    Text = "Inf Jump (5 studs)",
    Description = "Pula 5 studs infinitamente",
    Default = false,
    Callback = function(v)
        infiniteJumpEnabled = v
        notify("X HUB", v and "Inf Jump ON" or "Inf Jump OFF", v and "Success" or "Info")
    end,
})

UserInputService.JumpRequest:Connect(function()
    if not infiniteJumpEnabled or jumpDebounce then return end
    local _, h, root = getCC()
    if not h or not root or h.Health <= 0 then return end
    jumpDebounce = true
    local jv = math.sqrt(2 * workspace.Gravity * JUMP_HEIGHT)
    local vel = root.AssemblyLinearVelocity
    root.AssemblyLinearVelocity = Vector3.new(vel.X, jv, vel.Z)
    task.delay(0.15, function() jumpDebounce = false end)
end)

PlayerTab:Toggle({
    Text = "Anti Ragdoll",
    Description = "Não cai no chão",
    Default = false,
    Callback = function(v)
        if v then
            if ragdollConn then ragdollConn:Disconnect(); ragdollConn = nil end
            antiRagdollEnabled = true
            ragdollWas = false
            ragdollConn = RunService.Heartbeat:Connect(function()
                if not antiRagdollEnabled then return end
                local _, h, root = getCC()
                if not h or not root or h.Health <= 0 then return end
                local rg = h:GetState() == Enum.HumanoidStateType.Ragdoll
                    or h:GetState() == Enum.HumanoidStateType.Physics
                if rg and not ragdollWas then
                    ragdollPos = root.CFrame
                    ragdollAnchor = root
                    ragdollWas = true
                    root.CFrame = ragdollPos
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                    root.Anchored = true
                elseif rg and ragdollWas then
                    if ragdollAnchor and ragdollAnchor.Parent then
                        ragdollAnchor.CFrame = ragdollPos
                        ragdollAnchor.AssemblyLinearVelocity = Vector3.zero
                        ragdollAnchor.AssemblyAngularVelocity = Vector3.zero
                        ragdollAnchor.Anchored = true
                    end
                elseif not rg and ragdollWas then
                    if ragdollAnchor and ragdollAnchor.Parent then
                        ragdollAnchor.Anchored = false
                    end
                    ragdollAnchor = nil
                    ragdollPos = nil
                    ragdollWas = false
                end
            end)
        else
            antiRagdollEnabled = false
            if ragdollConn then ragdollConn:Disconnect(); ragdollConn = nil end
            local c = getCC()
            if c then
                for _, i in ipairs(c:GetDescendants()) do
                    if i:IsA("BasePart") and i.Name == "HumanoidRootPart" then
                        i.Anchored = false
                    end
                end
            end
        end
    end,
})

