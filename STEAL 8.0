-- Loops
RunService.Heartbeat:Connect(function()
    local emoteOn = (emoteRef and emoteRef.isActive()) or (autoStealRef and autoStealRef.isActive())
    if emoteOn and (not emoteTrack or not emoteTrack.IsPlaying) then
        local c, h = getCharHum(); if c and h then startEmote() end
    end
    if deitarRef and deitarRef.isActive() then
        local c, h = getCharHum(); if c and h then
            local rj = getRootJoint(c)
            if rj and rootJointOriginalC0 then rj.C0 = rootJointOriginalC0 * CFrame.Angles(math.rad(-90), 0, 0) end
            if humanoidOriginalHipHeight then h.HipHeight = humanoidOriginalHipHeight - 2 end
        end
    end
end)

RunService.Stepped:Connect(function()
    if autoStealRef and autoStealRef.isActive() then
        local c = player.Character
        if c then
            for _, v in ipairs(c:GetDescendants()) do
                if v:IsA("BasePart") and v.CanCollide then v.CanCollide = false end
            end
        end
    end
end)

-- Drag
local function draggable(obj, handle, click)
    local dragging, moved, startPos, startInput, dragInput
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true; moved = false; startInput = input.Position; startPos = obj.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    if not moved and click then click() end
                end
            end)
        end
    end)
    handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseMovement then
            dragInput = input
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input == dragInput then
            local d = input.Position - startInput
            if math.abs(d.X) > 5 or math.abs(d.Y) > 5 then moved = true end
            obj.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
end

-- Open/Close
local sOpened = false
local function toggleSPanel()
    sOpened = not sOpened
    if sOpened then
        stealPanel.Visible = true
        stealPanel.Size = UDim2.fromOffset(210, 260)
        TweenService:Create(stealPanel, TweenInfo.new(0.28, Enum.EasingStyle.Back), {Size = UDim2.fromOffset(270, 320)}):Play()
    else
        stealPanel.Visible = false
    end
end

draggable(floating, floating, toggleSPanel)
draggable(stealPanel, sHeader)

player.CharacterAdded:Connect(function()
    emoteTrack = nil; rootJointOriginalC0 = nil; neckOriginalC0 = nil; humanoidOriginalHipHeight = nil
    if emoteRef then emoteRef.reset() end
    if deitarRef then deitarRef.reset() end
    if autoStealRef then autoStealRef.reset() end
    setSStatus("SELECIONE UMA OPCAO")
end)

getgenv().StealBrainrotPanel = {
    Open = function()
        if not sOpened then toggleSPanel() end
    end,
    Close = function()
        if sOpened then toggleSPanel() end
    end,
    Toggle = toggleSPanel,
}
