    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 14)
    local st = Instance.new("UIStroke"); st.Color = Color3.fromRGB(120, 150, 220); st.Transparency = 0.65; st.Thickness = 1; st.Parent = btn
    pButtons[d.name] = btn
    pStates[d.name] = false
end

local function pAnimate(btn, isOn)
    local st = btn:FindFirstChildOfClass("UIStroke")
    local corner = btn:FindFirstChildOfClass("UICorner")
    if isOn then
        TweenService:Create(btn, TweenInfo.new(0.25), {BackgroundColor3 = Color3.fromRGB(79, 140, 255), BackgroundTransparency = 0, TextColor3 = Color3.new(1,1,1)}):Play()
        if st then TweenService:Create(st, TweenInfo.new(0.25), {Color = Color3.fromRGB(180, 210, 255), Transparency = 0.05, Thickness = 1.5}):Play() end
        if corner then TweenService:Create(corner, TweenInfo.new(0.35, Enum.EasingStyle.Back), {CornerRadius = UDim.new(1, 0)}):Play() end
    else
        TweenService:Create(btn, TweenInfo.new(0.25), {BackgroundColor3 = Color3.fromRGB(35, 42, 62), BackgroundTransparency = 0.15, TextColor3 = Color3.fromRGB(215, 228, 250)}):Play()
        if st then TweenService:Create(st, TweenInfo.new(0.25), {Color = Color3.fromRGB(120, 150, 220), Transparency = 0.65, Thickness = 1}):Play() end
        if corner then TweenService:Create(corner, TweenInfo.new(0.3), {CornerRadius = UDim.new(0, 14)}):Play() end
    end
end

local function pSetState(name, value, silent)
    local btn = pButtons[name]
    if not btn then return end
    if pStates[name] == value then return end
    pStates[name] = value
    if not silent then pAnimate(btn, value) end
    local cb = pCallbacks[name]
    if cb and not silent then
        local fn = value and cb.on or cb.off
        if fn then pcall(fn) end
    end
end

for name, btn in pairs(pButtons) do
    btn.Activated:Connect(function() pSetState(name, not pStates[name]) end)
end

local function pUpdateLock()
    if pLocked then
        lockBtn.Text = "TRAVADO"
        TweenService:Create(lockBtn, TweenInfo.new(0.25), {BackgroundColor3 = Color3.fromRGB(180, 60, 60)}):Play()
    else
        lockBtn.Text = "MOVER"
        TweenService:Create(lockBtn, TweenInfo.new(0.25), {BackgroundColor3 = Color3.fromRGB(35, 42, 62)}):Play()
    end
end
lockBtn.Activated:Connect(function() pLocked = not pLocked; pUpdateLock() end)
pUpdateLock()

-- Drag
local pDragging, pStart, pPos
hHeader.InputBegan:Connect(function(input)
    if pLocked then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        pDragging = true; pStart = input.Position; pPos = pvpPanel.Position
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if not pDragging then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then
        local d = input.Position - pStart
        pvpPanel.Position = UDim2.fromOffset(pPos.X.Offset + d.X, pPos.Y.Offset + d.Y)
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if not pDragging then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        pDragging = false
    end
end)

-- API
local pvpApi = {}
function pvpApi:On(n, onFn, offFn) pCallbacks[n] = {on = onFn, off = offFn} end
function pvpApi:Set(n, v) pSetState(n, v == true) end
function pvpApi:SetSilent(n, v) pSetState(n, v == true, true) end
function pvpApi:Get(n) return pStates[n] == true end
function pvpApi:Lock() pLocked = true; pUpdateLock() end
function pvpApi:Unlock() pLocked = false; pUpdateLock() end
function pvpApi:SetVisible(v) pvpPanel.Visible = v == true end
getgenv().XHubPvPPanel = pvpApi

-- Wire callbacks (usa funções do main script)
pvpApi:On("BatAura",
    function() if not auraEnabled then startAura() end end,
    function() if auraEnabled then stopAura() end end
)
pvpApi:On("AutoBat",
    function()
        autoBatEnabled = true; autoBatToken += 1
        local t = autoBatToken
        task.spawn(function()
            while autoBatEnabled and autoBatToken == t do
                local c, h = getCC(); local b = getBat()
                if c and h and h.Health > 0 and b then
                    if b.Parent ~= c then pcall(function() h:EquipTool(b) end) end
                    if b.Parent == c then pcall(function() b:Activate() end) end
                end
                task.wait(BAT_INTERVAL)
            end
        end)
    end,
    function() autoBatEnabled = false; autoBatToken += 1 end
)
pvpApi:On("SpeedCarry",
    function()
        speedMode = CARRY_SPEED; setSpeed(CARRY_SPEED); applySpeedEffects()
        pvpApi:SetSilent("NormalSpeed", false)
    end,
    function() if speedMode == CARRY_SPEED then speedMode = nil; setSpeed(nil); applySpeedEffects() end end
)
pvpApi:On("NormalSpeed",
    function()
        speedMode = NORMAL_SPEED; setSpeed(NORMAL_SPEED); applySpeedEffects()
        pvpApi:SetSilent("SpeedCarry", false)
    end,
    function() if speedMode == NORMAL_SPEED then speedMode = nil; setSpeed(nil); applySpeedEffects() end end
)
pvpApi:On("ESP",
    function() if not espEnabled then setESP(true) end end,
    function() if espEnabled then setESP(false) end end
)
pvpApi:On("AutoSteal",
    function() if not autoStealEnabled then startAutoSteal() end end,
    function() if autoStealEnabled then stopAutoSteal() end end
)
pvpApi:On("InfJump",
    function() infiniteJumpEnabled = true end,
    function() infiniteJumpEnabled = false end
)
pvpApi:On("AntiLag",
    function() if not antiLagEnabled then applyAntiLag() end end,
    function() if antiLagEnabled then removeAntiLag() end end
)

