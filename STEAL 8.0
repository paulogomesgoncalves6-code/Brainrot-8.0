-- Beams
local function beamC()
    local b = { Color3.fromRGB(0,200,255), Color3.fromRGB(140,80,255), Color3.fromRGB(255,80,180), Color3.fromRGB(80,255,190), Color3.fromRGB(255,210,100) }
    local n = #b; local t = n*3; local k = {}
    for i = 0, t do k[#k+1] = ColorSequenceKeypoint.new(i/t, b[(i%n)+1]) end
    return ColorSequence.new(k)
end
local function beamA()
    local c = {1/6, 3/6, 5/6}; local hw = 0.06
    local pts = {{0,1},{1,1}}
    for _,cc in ipairs(c) do
        table.insert(pts,{cc-hw,1}); table.insert(pts,{cc-hw*.5,.35})
        table.insert(pts,{cc,0}); table.insert(pts,{cc+hw*.5,.35})
        table.insert(pts,{cc+hw,1})
    end
    table.sort(pts, function(a,b) return a[1]<b[1] end)
    local k, p = {}, -1
    for _,q in ipairs(pts) do
        local t = math.clamp(q[1],0,1)
        if t-p > 0.001 then k[#k+1] = NumberSequenceKeypoint.new(t,q[2]); p=t end
    end
    return NumberSequence.new(k)
end

