local hasDrawing = false
pcall(function()
    local t = Drawing.new("Line"); t:Remove(); hasDrawing = true
end)

-- Alerta pequeno bonito + som real
local alertGui = Instance.new("ScreenGui")
alertGui.Name = "XHubAlert"
alertGui.ResetOnSpawn = false
alertGui.DisplayOrder = 998
alertGui.Parent = playerGui

local alertSound = Instance.new("Sound")
alertSound.SoundId = "rbxassetid://5410086226"
alertSound.Volume = 2
alertSound.Parent = SoundService

local lastAlert = 0
local alertActive = false

local function showAlert()
    if alertActive or (os.clock() - lastAlert < 5) then return end
    lastAlert = os.clock()
    alertActive = true

    local toast = Instance.new("Frame")
    toast.Size = UDim2.fromOffset(200, 44)
    toast.Position = UDim2.new(0.5, -100, 0, -60)
    toast.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
    toast.BackgroundTransparency = 0.1
    toast.BorderSizePixel = 0
    toast.Parent = alertGui

    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(1, 0); c.Parent = toast
    local s = Instance.new("UIStroke")
    s.Color = Color3.fromRGB(255, 80, 80); s.Thickness = 1.5; s.Transparency = 0.2; s.Parent = toast

    local icon = Instance.new("TextLabel")
    icon.Size = UDim2.fromOffset(30, 44)
    icon.Position = UDim2.fromOffset(10, 0)
    icon.BackgroundTransparency = 1
    icon.Text = "⚠"; icon.TextSize = 22
    icon.TextColor3 = Color3.fromRGB(255, 90, 90)
    icon.Font = Enum.Font.GothamBold
    icon.Parent = toast

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -50, 1, 0)
    lbl.Position = UDim2.fromOffset(44, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = "PLAYER DETECTADO!"
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextColor3 = Color3.fromRGB(255, 240, 240)
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 13
    lbl.Parent = toast

    TweenService:Create(toast,
        TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        { Position = UDim2.new(0.5, -100, 0, 20) }):Play()
    pcall(function() alertSound:Play() end)

    task.delay(2, function()
        TweenService:Create(toast,
            TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
            { Position = UDim2.new(0.5, -100, 0, -60) }):Play()
        task.wait(0.5)
        toast:Destroy()
        alertActive = false
    end)
end

local function removeESP(target)
    local d = espObjects[target]
    if d then
        if d.hl then d.hl:Destroy() end
        if d.bb then d.bb:Destroy() end
        if d.dw then
            if d.dw.line then d.dw.line:Remove() end
            for _, l in ipairs(d.dw.box) do l:Remove() end
        end
        espObjects[target] = nil
    end
end

local function addESP(target)
    if not espEnabled or target == player then return end
    local c = target.Character
    local head = c and c:FindFirstChild("Head")
    if not c or not head then return end
    local ex = espObjects[target]
    if ex and ex.character == c then return end
    removeESP(target)

    local hl = Instance.new("Highlight")
    hl.Adornee = c
    hl.FillTransparency = 0.65
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = c

    local bb = Instance.new("BillboardGui")
    bb.Adornee = head
    bb.Size = UDim2.new(0, 180, 0, 30)
    bb.StudsOffset = Vector3.new(0, 2.5, 0)
    bb.AlwaysOnTop = true
    bb.Parent = head

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.fromScale(1, 1)
    lbl.BackgroundTransparency = 1
    lbl.Text = target.DisplayName .. " (@" .. target.Name .. ")"
    lbl.TextStrokeTransparency = 0
    lbl.TextScaled = true
    lbl.Font = Enum.Font.GothamBold
    lbl.Parent = bb

    local dw = nil
    if hasDrawing then
        local line = Drawing.new("Line")
        line.Thickness = 2; line.Transparency = 1; line.Visible = false
        local box = {}
        for _ = 1, 4 do
            local l = Drawing.new("Line")
            l.Thickness = 1.5; l.Transparency = 1; l.Visible = false
            table.insert(box, l)
        end
        dw = { line = line, box = box }
    end

    espObjects[target] = { character = c, hl = hl, bb = bb, label = lbl, dw = dw }
end

local function refreshESP()
    for _, t in ipairs(Players:GetPlayers()) do
        if t ~= player then addESP(t) end
    end
end

local function setESP(v)
    espEnabled = v
    if v then refreshESP()
    else
        local list = {}
        for t in pairs(espObjects) do table.insert(list, t) end
        for _, t in ipairs(list) do removeESP(t) end
    end
end

RunService.RenderStepped:Connect(function()
    if not espEnabled then return end
    local cam = workspace.CurrentCamera
    if not cam then return end
    local myChar = player.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local hue = (os.clock() * ESP_RAINBOW_SPEED) % 1
    local mc = Color3.fromHSV(hue, 1, 1)
    local oc = Color3.fromHSV((hue + 0.5) % 1, 1, 1)
    local anyClose = false

    for _, d in pairs(espObjects) do
        if d.hl and d.hl.Parent then
            d.hl.FillColor = mc
            d.hl.OutlineColor = oc
        end
        if d.label and d.label.Parent then d.label.TextColor3 = mc end

        if d.dw and d.character and d.character.Parent then
            local head = d.character:FindFirstChild("Head")
            local hrp = d.character:FindFirstChild("HumanoidRootPart")
            local hum = d.character:FindFirstChildOfClass("Humanoid")
            local alive = hum and hum.Health > 0
            if d.bb then d.bb.Enabled = alive end

            if alive and head and hrp then
                if myRoot and (hrp.Position - myRoot.Position).Magnitude <= ESP_DETECT_RANGE then
                    anyClose = true
                end
                local hs, hon = cam:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                local fs, fon = cam:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
                local hv = hon and hs.Z > 0
                local fv = fon and fs.Z > 0

                if d.dw.line then
                    if myRoot and hv then
                        local ms, mon = cam:WorldToViewportPoint(myRoot.Position)
                        if mon and ms.Z > 0 then
                            d.dw.line.Visible = true
                            d.dw.line.From = Vector2.new(ms.X, ms.Y)
                            d.dw.line.To = Vector2.new(hs.X, hs.Y)
                            d.dw.line.Color = mc
                        else
                            d.dw.line.Visible = false
                        end
                    else
                        d.dw.line.Visible = false
                    end
                end

                if hv and fv then
                    local hh = math.clamp(math.abs(fs.Y - hs.Y), 20, 500)
                    local ww = hh * 0.5
                    local cx = hs.X
                    local ty = math.min(hs.Y, fs.Y)
                    local by = math.max(hs.Y, fs.Y)
                    d.dw.box[1].From = Vector2.new(cx - ww/2, ty)
                    d.dw.box[1].To   = Vector2.new(cx + ww/2, ty)
                    d.dw.box[2].From = Vector2.new(cx - ww/2, by)
                    d.dw.box[2].To   = Vector2.new(cx + ww/2, by)
                    d.dw.box[3].From = Vector2.new(cx - ww/2, ty)
                    d.dw.box[3].To   = Vector2.new(cx - ww/2, by)
                    d.dw.box[4].From = Vector2.new(cx + ww/2, ty)
                    d.dw.box[4].To   = Vector2.new(cx + ww/2, by)
                    for _, l in ipairs(d.dw.box) do
                        l.Visible = true
                        l.Color = oc
                    end
                else
                    for _, l in ipairs(d.dw.box) do l.Visible = false end
                end
            else
                if d.dw.line then d.dw.line.Visible = false end
                for _, l in ipairs(d.dw.box) do l.Visible = false end
            end
        end
    end

    if anyClose then showAlert() end
end)

local function watch(t)
    if t == player then return end
    t.CharacterAdded:Connect(function()
        task.wait(1)
        addESP(t)
    end)
end
Players.PlayerAdded:Connect(watch)
Players.PlayerRemoving:Connect(function(t) removeESP(t) end)
for _, t in ipairs(Players:GetPlayers()) do watch(t) end

--==================================================
-- SPEED CARRY / NORMAL (lift 8 studs + anim zerada)
--==================================================
local function stopLift()
    if liftConn then liftConn:Disconnect(); liftConn = nil end
    if liftPad then liftPad:Destroy(); liftPad = nil end
end

local function applySpeedEffects()
    if slowAnimConn then slowAnimConn:Disconnect(); slowAnimConn = nil end
    stopLift()
    if not speedMode then return end

    slowAnimConn = RunService.Heartbeat:Connect(function()
        local _, h = getCC()
        local anim = h and h:FindFirstChildOfClass("Animator")
        if not anim then return end
        for _, tr in ipairs(anim:GetPlayingAnimationTracks()) do
            local a = tr.Animation
            if a then
                local n = string.lower(tr.Name .. " " .. a.Name)
                if string.find(n, "walk") or string.find(n, "run") or string.find(n, "idle") then
                    tr:AdjustSpeed(0)
                end
            end
        end
    end)

    task.spawn(function()
        task.wait(0.1)
        local _, h, root = getCC()
        if not h or not root then return end
        local baseY = root.Position.Y + LIFT_STUDS
        root.CFrame = CFrame.new(root.Position.X, baseY, root.Position.Z)
        task.wait(0.1)

        liftPad = Instance.new("Part")
        liftPad.Name = "XHubSpeedLift"
        liftPad.Size = Vector3.new(6, 1, 6)
        liftPad.Anchored = true
        liftPad.CanCollide = true
        liftPad.CanTouch = false
        liftPad.CanQuery = false
        liftPad.Transparency = 1
        liftPad.CFrame = CFrame.new(root.Position - Vector3.new(0, 3.5, 0))
        liftPad.Parent = workspace

        liftConn = RunService.Heartbeat:Connect(function()
            if not speedMode or not liftPad then return end
            if auraEnabled then return end
            local _, hh, rr = getCC()
            if not hh or not rr or hh.Health <= 0 then return end
            hh.WalkSpeed = speedMode
            if rr.Position.Y < baseY - 1 then
                liftPad.CFrame = CFrame.new(rr.Position.X, rr.Position.Y - 3.5, rr.Position.Z)
            else
                liftPad.CFrame = CFrame.new(rr.Position.X, baseY - 3.5, rr.Position.Z)
            end
        end)
    end)
end

--==================================================
-- AURA (persegue + olha + ativa Anti Reset junto)
--==================================================
local function getNearestPlayer()
    local _, _, myRoot = getCC()
    if not myRoot then return nil end
    local nearest, shortest = nil, math.huge
    for _, t in ipairs(Players:GetPlayers()) do
        if t ~= player then
            local c = t.Character
            local h = c and c:FindFirstChildOfClass("Humanoid")
            local r = c and c:FindFirstChild("HumanoidRootPart")
            if h and r and h.Health > 0 then
                local d = (r.Position - myRoot.Position).Magnitude
                if d < shortest then shortest = d; nearest = t end
            end
        end
    end
    return nearest
end

local function stopAura()
    auraEnabled = false
    auraToken += 1
    local _, h = getCC()
    if h then
        h:Move(Vector3.zero, false)
        h.WalkSpeed = speedMode or currentSpeed or 16
    end
end

local function startAura()
    stopAura()
    auraEnabled = true
    auraToken += 1
    local myToken = auraToken

    task.spawn(function()
        local lastAct = 0
        while auraEnabled and auraToken == myToken do
            local c, h, root = getCC()
            if not c or not h or not root or h.Health <= 0 then
                task.wait(0.1)
                continue
            end
            h.WalkSpeed = AURA_SPEED
            local target = getNearestPlayer()
            local tc = target and target.Character
            local th = tc and tc:FindFirstChildOfClass("Humanoid")
            local tr = tc and tc:FindFirstChild("HumanoidRootPart")
            if tr and th and th.Health > 0 then
                local myPos = root.Position
                local tPos = tr.Position
                local flat = Vector3.new(tPos.X, myPos.Y, tPos.Z)
                if (flat - myPos).Magnitude > 0.5 then
                    local sv = root.AssemblyLinearVelocity
                    root.CFrame = CFrame.lookAt(myPos, flat)
                    root.AssemblyLinearVelocity = sv
                end
                local dest = tPos + tr.CFrame.LookVector * FOLLOW_DIST
                local offset = dest - root.Position
                local dist = offset.Magnitude
                if dist > 1.5 then
                    local dir = offset.Unit
                    local tv = tr.AssemblyLinearVelocity
                    local spd = math.max(AURA_SPEED, tv.Magnitude + 5)
                    local nv = dir * spd
                    local vd = tPos.Y - root.Position.Y
                    if vd > 2 then
                        nv = Vector3.new(nv.X, math.max(nv.Y, 25 + vd), nv.Z)
                    elseif vd < -5 then
                        nv = Vector3.new(nv.X, vd * 3, nv.Z)
                    end
                    root.AssemblyLinearVelocity = nv
                elseif dist < 1 then
                    local dir = -offset.Unit
                    root.AssemblyLinearVelocity = Vector3.new(dir.X, 0, dir.Z) * 30
                end
                if os.clock() - lastAct >= BAT_INTERVAL then
                    local bat = equipBat()
                    if bat and bat.Parent == c then
                        lastAct = os.clock()
                        pcall(function() bat:Activate() end)
                    end
                end
            end
            task.wait(0.05)
        end
    end)
end
