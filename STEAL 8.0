local PlayerTab = Menu:Tab({ Text = "Player", Icon = "user" })

PlayerTab:BoldLabel({ Text = "Speed", Description = "Levita 8 studs + animação zerada" })

PlayerTab:Toggle({
    Text = "Carry speed (29)",
    Description = "Levita 8 studs + speed 29 + animação zerada",
    Default = false,
    Callback = function(v)
        if v then
            speedMode = CARRY_SPEED
            setSpeed(CARRY_SPEED)
            applySpeedEffects()
        elseif speedMode == CARRY_SPEED then
            speedMode = nil
            setSpeed(nil)
            applySpeedEffects()
        end
    end,
})

PlayerTab:Toggle({
    Text = "Normal speed (59)",
    Description = "Levita 8 studs + speed 59 + animação zerada",
    Default = false,
    Callback = function(v)
        if v then
            speedMode = NORMAL_SPEED
            setSpeed(NORMAL_SPEED)
            applySpeedEffects()
        elseif speedMode == NORMAL_SPEED then
            speedMode = nil
            setSpeed(nil)
            applySpeedEffects()
        end
    end,
})

PlayerTab:Button({
    Text = "Restaurar Speed",
    Icon = "rotate-ccw",
    Callback = function()
        speedMode = nil
        setSpeed(nil)
        applySpeedEffects()
        notify("X HUB", "Speed restaurado", "Info")
    end,
})

PlayerTab:Divider()
PlayerTab:BoldLabel({ Text = "Movimento" })

PlayerTab:Toggle({
    Text = "Float",
    Description = "Voa e desce rápido",
    Default = false,
    Callback = function(v)
        floatEnabled = v
        if floatConn then floatConn:Disconnect(); floatConn = nil end
        if v then
            floatConn = RunService.Heartbeat:Connect(function()
                if not floatEnabled or speedMode or auraEnabled then return end
                local _, h, root = getCC()
                if not h or not root or h.Health <= 0 then return end
                h.WalkSpeed = 28
                if h.FloorMaterial == Enum.Material.Air then
                    local vel = root.AssemblyLinearVelocity
                    if vel.Y < 0 then
                        root.AssemblyLinearVelocity = Vector3.new(vel.X, math.max(vel.Y - 4, -120), vel.Z)
                    end
                end
            end)
        end
    end,
})

PlayerTab:Toggle({
    Text = "Inf Jump (5 studs)",
    Description = "Pula 5 studs infinitamente",
    Default = false,
    Callback = function(v)
        infiniteJumpEnabled = v
        notify("X HUB", v and "Inf Jump ON" or "Inf Jump OFF", v and "Success" or "Info")
    end,
})

UserInputService.JumpRequest:Connect(function()
    if not infiniteJumpEnabled or jumpDebounce then return end
    local _, h, root = getCC()
    if not h or not root or h.Health <= 0 then return end
    jumpDebounce = true
    local jv = math.sqrt(2 * workspace.Gravity * JUMP_HEIGHT)
    local vel = root.AssemblyLinearVelocity
    root.AssemblyLinearVelocity = Vector3.new(vel.X, jv, vel.Z)
    task.delay(0.15, function() jumpDebounce = false end)
end)

PlayerTab:Toggle({
    Text = "Anti Ragdoll",
    Description = "Não cai no chão",
    Default = false,
    Callback = function(v)
        if v then
            if ragdollConn then ragdollConn:Disconnect(); ragdollConn = nil end
            antiRagdollEnabled = true
            ragdollWas = false
            ragdollConn = RunService.Heartbeat:Connect(function()
                if not antiRagdollEnabled then return end
                local _, h, root = getCC()
                if not h or not root or h.Health <= 0 then return end
                local rg = h:GetState() == Enum.HumanoidStateType.Ragdoll
                    or h:GetState() == Enum.HumanoidStateType.Physics
                if rg and not ragdollWas then
                    ragdollPos = root.CFrame
                    ragdollAnchor = root
                    ragdollWas = true
                    root.CFrame = ragdollPos
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                    root.Anchored = true
                elseif rg and ragdollWas then
                    if ragdollAnchor and ragdollAnchor.Parent then
                        ragdollAnchor.CFrame = ragdollPos
                        ragdollAnchor.AssemblyLinearVelocity = Vector3.zero
                        ragdollAnchor.AssemblyAngularVelocity = Vector3.zero
                        ragdollAnchor.Anchored = true
                    end
                elseif not rg and ragdollWas then
                    if ragdollAnchor and ragdollAnchor.Parent then
                        ragdollAnchor.Anchored = false
                    end
                    ragdollAnchor = nil
                    ragdollPos = nil
                    ragdollWas = false
                end
            end)
        else
            antiRagdollEnabled = false
            if ragdollConn then ragdollConn:Disconnect(); ragdollConn = nil end
            local c = getCC()
            if c then
                for _, i in ipairs(c:GetDescendants()) do
                    if i:IsA("BasePart") and i.Name == "HumanoidRootPart" then
                        i.Anchored = false
                    end
                end
            end
        end
    end,
})

PlayerTab:Divider()
PlayerTab:BoldLabel({ Text = "Bat / Aura" })

PlayerTab:Toggle({
    Text = "Auto Bat",
    Description = "Equipa e ativa o Bat",
    Default = false,
    Callback = function(v)
        autoBatEnabled = v
        autoBatToken += 1
        local myToken = autoBatToken
        if v then
            task.spawn(function()
                while autoBatEnabled and autoBatToken == myToken do
                    local c, h = getCC()
                    local bat = getBat()
                    if c and h and h.Health > 0 and bat then
                        if bat.Parent ~= c then pcall(function() h:EquipTool(bat) end) end
                        if bat.Parent == c then pcall(function() bat:Activate() end) end
                    end
                    task.wait(BAT_INTERVAL)
                end
            end)
        end
    end,
})

PlayerTab:Toggle({
    Text = "Bat Aura",
    Description = "Persegue + olha + ativa Anti Reset junto",
    Default = false,
    Callback = function(v)
        if v and not auraEnabled then
            startAura()
            if not antiResetEnabled then
                antiResetEnabled = true
                applyResetBlock()
                if antiResetConn then antiResetConn:Disconnect(); antiResetConn = nil end
                antiResetConn = RunService.Heartbeat:Connect(function()
                    if not antiResetEnabled then return end
                    local _, h = getCC()
                    if not h then return end
                    pcall(function()
                        h:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
                    end)
                    if h.Health <= 0 then h.Health = h.MaxHealth end
                    if h:GetState() == Enum.HumanoidStateType.Dead then
                        h:ChangeState(Enum.HumanoidStateType.Running)
                    end
                end)
            end
        elseif not v and auraEnabled then
            stopAura()
        end
    end,
})

PlayerTab:Toggle({
    Text = "ESP Player",
    Description = "Linha + caixa + nome rainbow + alerta",
    Default = false,
    Callback = setESP,
})
--==================================================
-- PARTE 4 — ANTI RESET + ANTI LAG + ABA 3 + ABA 4
--==================================================

--==================================================
-- ANTI RESET (funções base)
--==================================================
function applyResetBlock()
    if not antiResetEnabled then return end
    pcall(function() StarterGui:SetCore("ResetButtonCallback", false) end)
end

--==================================================
-- ANTI LAG
--==================================================
local antiLagBackup = { fov = 70, lighting = {}, particles = {} }

local function applyAntiLag()
    if antiLagEnabled then return end
    antiLagEnabled = true

    local cam = workspace.CurrentCamera
    if cam then
        antiLagBackup.fov = cam.FieldOfView
        cam.FieldOfView = 90
    end

    -- Remove animações do player
    local char = player.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        local anim = hum and hum:FindFirstChildOfClass("Animator")
        if anim then
            for _, track in ipairs(anim:GetPlayingAnimationTracks()) do
                pcall(function() track:Stop() end)
            end
        end
    end

    if antiLagBackup.animConn then antiLagBackup.animConn:Disconnect() end
    antiLagBackup.animConn = RunService.Heartbeat:Connect(function()
        if not antiLagEnabled then return end
        local _, h = getCC()
        local anim = h and h:FindFirstChildOfClass("Animator")
        if not anim then return end
        for _, tr in ipairs(anim:GetPlayingAnimationTracks()) do
            local a = tr.Animation
            if a then
                local n = string.lower(tr.Name .. " " .. a.Name)
                if string.find(n, "walk") or string.find(n, "run")
                or string.find(n, "idle") or string.find(n, "jump")
                or string.find(n, "fall") or string.find(n, "climb") then
                    tr:AdjustSpeed(0)
                end
            end
        end
    end)

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ParticleEmitter") or obj:IsA("Fire")
        or obj:IsA("Smoke") or obj:IsA("Sparkles")
        or obj:IsA("Trail") or obj:IsA("Beam") then
            pcall(function()
                if obj.Enabled then
                    table.insert(antiLagBackup.particles, obj)
                    obj.Enabled = false
                end
            end)
        end
    end

    for _, l in ipairs(Lighting:GetChildren()) do
        if l:IsA("PostEffect") or l:IsA("Atmosphere")
        or l:IsA("BloomEffect") or l:IsA("BlurEffect")
        or l:IsA("SunRaysEffect") or l:IsA("ColorCorrectionEffect")
        or l:IsA("DepthOfFieldEffect") then
            pcall(function()
                if l.Enabled then
                    antiLagBackup.lighting[l] = true
                    l.Enabled = false
                end
            end)
        end
    end

    notify("X HUB", "Anti Lag ON", "Success")
end

local function removeAntiLag()
    if not antiLagEnabled then return end
    antiLagEnabled = false

    local cam = workspace.CurrentCamera
    if cam then cam.FieldOfView = antiLagBackup.fov end

    if antiLagBackup.animConn then
        antiLagBackup.animConn:Disconnect()
        antiLagBackup.animConn = nil
    end

    for _, obj in ipairs(antiLagBackup.particles) do
        pcall(function()
            if obj and obj.Parent then obj.Enabled = true end
        end)
    end
    table.clear(antiLagBackup.particles)

    for effect in pairs(antiLagBackup.lighting) do
        pcall(function()
            if effect and effect.Parent then effect.Enabled = true end
        end)
    end
    table.clear(antiLagBackup.lighting)

    notify("X HUB", "Anti Lag OFF", "Info")
end

--==================================================
-- ABA 3: MÚSICA + DISCORD
--==================================================
local MusicTab = Menu:Tab({ Text = "Música", Icon = "music" })

MusicTab:BoldLabel({
    Text = "X HUB Music",
    Description = "Sons e comunidade",
})

MusicTab:Input({
    Text = "ID da Música",
    Description = "Cole o ID do áudio (ex: 97825347303470)",
    Placeholder = "97825347303470",
    Numeric = true,
    Flag = "MusicIdInput",
})

local musicSound = nil
MusicTab:Button({
    Text = "Tocar Música (30s)",
    Description = "Toca a música do ID acima por 30 segundos",
    Icon = "play",
    Callback = function()
        local flag = Menu and Menu.Flags and Menu.Flags["MusicIdInput"]
        local id = (flag and tostring(flag)) or "97825347303470"
        if musicSound and musicSound.Parent then musicSound:Destroy() end
        musicSound = Instance.new("Sound")
        musicSound.SoundId = "rbxassetid://" .. id
        musicSound.Volume = 0.5
        musicSound.Parent = SoundService
        musicSound:Play()
        notify("X HUB", "Música tocando (30s): " .. id, "Success")
        task.delay(30, function()
            if musicSound and musicSound.Parent then
                musicSound:Destroy(); musicSound = nil
                notify("X HUB", "Música finalizada", "Info")
            end
        end)
    end,
})

MusicTab:Button({
    Text = "Parar Música",
    Icon = "square",
    Callback = function()
        if musicSound and musicSound.Parent then
            musicSound:Destroy(); musicSound = nil
            notify("X HUB", "Música parada", "Info")
        end
    end,
})

MusicTab:Divider()
MusicTab:BoldLabel({ Text = "Discord" })
MusicTab:Label({ Text = "<b>Discord:</b> " .. DISCORD_URL })

MusicTab:Button({
    Text = "Copiar Discord",
    Description = "Copia o link do Discord",
    Icon = "copy",
    Callback = function()
        if typeof(setclipboard) == "function" then
            if pcall(function() setclipboard(DISCORD_URL) end) then
                notify("X HUB", "Discord copiado!", "Success")
                return
            end
        end
        notify("X HUB", DISCORD_URL, "Info")
    end,
})

