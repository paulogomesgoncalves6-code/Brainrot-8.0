local PvPTab = Menu:Tab({ Text = "PvP Panel", Icon = "swords" })

PvPTab:BoldLabel({
    Text = "Painel PvP Mobile",
    Description = "Botões rápidos sobre a tela",
})

local pvpPanelVisible = false

PvPTab:Toggle({
    Text = "Mostrar Painel PvP",
    Description = "Abre o painel mobile com botões rápidos",
    Default = false,
    Callback = function(v)
        pvpPanelVisible = v
        local api = getgenv().XHubPvPPanel
        if api and api.SetVisible then
            pcall(function() api:SetVisible(v) end)
        end
    end,
})

PvPTab:Button({
    Text = "Abrir Painel PvP",
    Description = "Abre o painel PvP flutuante",
    Icon = "layout-grid",
    Callback = function()
        local api = getgenv().XHubPvPPanel
        if api and api.SetVisible then
            pcall(function() api:SetVisible(true) end)
            pvpPanelVisible = true
        end
    end,
})

PvPTab:Button({
    Text = "Fechar Painel PvP",
    Icon = "x",
    Callback = function()
        local api = getgenv().XHubPvPPanel
        if api and api.SetVisible then
            pcall(function() api:SetVisible(false) end)
            pvpPanelVisible = false
        end
    end,
})

PvPTab:Divider()
PvPTab:BoldLabel({ Text = "Anti Reset / Anti Lag" })

PvPTab:Toggle({
    Text = "Anti Reset",
    Description = "HP vai a 0 mas você não morre",
    Default = false,
    Callback = function(v)
        antiResetEnabled = v
        if v then
            applyResetBlock()
            if antiResetConn then antiResetConn:Disconnect(); antiResetConn = nil end
            antiResetConn = RunService.Heartbeat:Connect(function()
                if not antiResetEnabled then return end
                local _, h = getCC()
                if not h then return end
                pcall(function()
                    h:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
                end)
                if h.Health <= 0 then h.Health = h.MaxHealth end
                if h:GetState() == Enum.HumanoidStateType.Dead then
                    h:ChangeState(Enum.HumanoidStateType.Running)
                end
            end)
            task.spawn(function()
                for _ = 1, 30 do
                    if not antiResetEnabled then break end
                    applyResetBlock()
                    task.wait(1)
                end
            end)
            notify("X HUB", "Anti Reset ON", "Success")
        else
            if antiResetConn then antiResetConn:Disconnect(); antiResetConn = nil end
            local _, h = getCC()
            if h then pcall(function() h:SetStateEnabled(Enum.HumanoidStateType.Dead, true) end) end
            pcall(function() StarterGui:SetCore("ResetButtonCallback", true) end)
            notify("X HUB", "Anti Reset OFF", "Info")
        end
    end,
})

PvPTab:Toggle({
    Text = "Anti Lag",
    Description = "Remove anim + partículas + estica tela",
    Default = false,
    Callback = function(v)
        if v then applyAntiLag() else removeAntiLag() end
    end,
})

--==================================================
-- CHARACTER ADDED (reset geral)
--==================================================
player.CharacterAdded:Connect(function()
    task.wait(1)
    local _, h = getCC()
    if h and currentSpeed and not auraEnabled then
        h.WalkSpeed = currentSpeed
    end
    if speedMode then applySpeedEffects() end
    if antiResetEnabled then applyResetBlock() end
    if espEnabled then refreshESP() end
    if auraEnabled then stopAura() end
end)

notify("X HUB Mobile", "Menu Armenta carregado!", "Success")
