-- Lógica emote / deitar
local emoteTrack
local rootJointOriginalC0, neckOriginalC0, humanoidOriginalHipHeight
local function getCharHum()
    local c = player.Character
    if not c then return nil end
    return c, c:FindFirstChildOfClass("Humanoid")
end
local function getRootJoint(c) local hrp = c:FindFirstChild("HumanoidRootPart"); return hrp and hrp:FindFirstChild("RootJoint") end
local function getNeck(c) local t = c:FindFirstChild("UpperTorso") or c:FindFirstChild("Torso"); return t and t:FindFirstChild("Neck") end
local function startEmote()
    local c, h = getCharHum(); if not c or not h then return end
    if emoteTrack then emoteTrack:Stop() end
    local anim = Instance.new("Animation")
    anim.AnimationId = EMOTE_ID
    emoteTrack = h:LoadAnimation(anim)
    emoteTrack.Looped = true
    emoteTrack.Priority = Enum.AnimationPriority.Action
    emoteTrack:Play()
end
local function stopEmote() if emoteTrack then emoteTrack:Stop(); emoteTrack = nil end end
local function deitar()
    local c, h = getCharHum(); if not c or not h then return end
    local rj = getRootJoint(c)
    if rj then
        if not rootJointOriginalC0 then rootJointOriginalC0 = rj.C0 end
        rj.C0 = rootJointOriginalC0 * CFrame.Angles(math.rad(-90), 0, 0)
    end
    local nk = getNeck(c)
    if nk then
        if not neckOriginalC0 then neckOriginalC0 = nk.C0 end
        nk.C0 = neckOriginalC0 * CFrame.Angles(math.rad(-20), 0, 0)
    end
    if humanoidOriginalHipHeight == nil then humanoidOriginalHipHeight = h.HipHeight end
    h.HipHeight = humanoidOriginalHipHeight - 2
end
local function voltarNormal()
    local c, h = getCharHum(); if not c or not h then return end
    local rj = getRootJoint(c)
    if rj and rootJointOriginalC0 then
        TweenService:Create(rj, TweenInfo.new(0.3), {C0 = rootJointOriginalC0}):Play()
    end
    local nk = getNeck(c)
    if nk and neckOriginalC0 then
        TweenService:Create(nk, TweenInfo.new(0.3), {C0 = neckOriginalC0}):Play()
    end
    if humanoidOriginalHipHeight then h.HipHeight = humanoidOriginalHipHeight; humanoidOriginalHipHeight = nil end
end

-- Toggle creator
local emoteRef, deitarRef, autoStealRef
local function createToggle(text, order, onToggle)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 44)
    btn.BackgroundColor3 = Color3.fromRGB(55, 0, 0)
    btn.BorderSizePixel = 0
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.LayoutOrder = order
    btn.ZIndex = 22
    btn.Parent = sContent
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    local st = Instance.new("UIStroke"); st.Color = Color3.fromRGB(255, 20, 20); st.Thickness = 1.5; st.Parent = btn
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -80, 1, 0)
    lbl.Position = UDim2.fromOffset(12, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = Color3.new(1,1,1)
    lbl.Font = Enum.Font.GothamBlack
    lbl.TextSize = 12
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.ZIndex = 23
    lbl.Parent = btn
    local track = Instance.new("Frame")
    track.Size = UDim2.fromOffset(52, 26)
    track.Position = UDim2.new(1, -62, 0.5, -13)
    track.BackgroundColor3 = Color3.fromRGB(30, 0, 0)
    track.BorderSizePixel = 0
    track.ZIndex = 23
    track.Parent = btn
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)
    local ball = Instance.new("Frame")
    ball.Size = UDim2.fromOffset(22, 22)
    ball.Position = UDim2.fromOffset(2, 2)
    ball.BackgroundColor3 = Color3.fromRGB(140, 0, 0)
    ball.BorderSizePixel = 0
    ball.ZIndex = 24
    ball.Parent = track
    Instance.new("UICorner", ball).CornerRadius = UDim.new(1, 0)
    local isOn = false
    local function applyV(v)
        if v then
            TweenService:Create(ball, TweenInfo.new(0.28, Enum.EasingStyle.Back), {Position = UDim2.fromOffset(28, 2), BackgroundColor3 = Color3.fromRGB(0, 220, 100), Size = UDim2.fromOffset(24, 24)}):Play()
            TweenService:Create(btn, TweenInfo.new(0.25), {BackgroundColor3 = Color3.fromRGB(15, 70, 25)}):Play()
            TweenService:Create(st, TweenInfo.new(0.25), {Color = Color3.fromRGB(0, 255, 100)}):Play()
        else
            TweenService:Create(ball, TweenInfo.new(0.28, Enum.EasingStyle.Back), {Position = UDim2.fromOffset(2, 2), BackgroundColor3 = Color3.fromRGB(140, 0, 0), Size = UDim2.fromOffset(22, 22)}):Play()
            TweenService:Create(btn, TweenInfo.new(0.25), {BackgroundColor3 = Color3.fromRGB(55, 0, 0)}):Play()
            TweenService:Create(st, TweenInfo.new(0.25), {Color = Color3.fromRGB(255, 20, 20)}):Play()
        end
    end
    local function set(v)
        if isOn == v then return end
        isOn = v
        applyV(v)
        if onToggle then onToggle(v) end
    end
    btn.Activated:Connect(function() set(not isOn) end)
    return {set = set, reset = function() isOn = false; applyV(false) end, isActive = function() return isOn end}
end

