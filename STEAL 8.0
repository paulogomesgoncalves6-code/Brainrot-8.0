-- Auto Steal (ProximityPrompt global)
local autoStealEnabled = false
local autoStealToken = 0
local heldPrompt = nil

local function getPromptPosition(prompt)
    local p = prompt.Parent
    while p and p ~= workspace do
        if p:IsA("Attachment") then return p.WorldPosition
        elseif p:IsA("BasePart") then return p.Position
        elseif p:IsA("Model") then return p:GetPivot().Position end
        p = p.Parent
    end
    return nil
end

local function findNearestPrompt()
    local c = player.Character
    if not c then return nil end
    local root = c:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local nearest, shortest = nil, math.huge
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Enabled then
            local pos = getPromptPosition(obj)
            if pos then
                local d = (root.Position - pos).Magnitude
                if d <= obj.MaxActivationDistance and d < shortest then
                    shortest = d; nearest = obj
                end
            end
        end
    end
    return nearest
end

local function releasePrompt()
    local p = heldPrompt; heldPrompt = nil
    if p then pcall(function() p:InputHoldEnd() end) end
end

local function autoInteraction(myToken)
    while autoStealEnabled and autoStealToken == myToken do
        local prompt = findNearestPrompt()
        if prompt then
            local ok = pcall(function()
                heldPrompt = prompt
                prompt:InputHoldBegin()
            end)
            if ok then
                local hold = prompt.HoldDuration
                local start = os.clock()
                while autoStealEnabled and autoStealToken == myToken
                and prompt.Parent and prompt.Enabled do
                    local elapsed = os.clock() - start
                    if elapsed >= hold + 0.3 then break end
                    local c = player.Character
                    local r = c and c:FindFirstChild("HumanoidRootPart")
                    local p = getPromptPosition(prompt)
                    if not r or not p then break end
                    if (r.Position - p).Magnitude > prompt.MaxActivationDistance then break end
                    task.wait(0.03)
                end
            end
            releasePrompt()
            task.wait(0.15)
        else
            task.wait(0.15)
        end
    end
    releasePrompt()
end

local function startAutoSteal()
    if autoStealEnabled then return end
    autoStealEnabled = true
    autoStealToken += 1
    task.spawn(function() autoInteraction(autoStealToken) end)
    notify("X HUB", "Auto Steal ON", "Success")
end

local function stopAutoSteal()
    autoStealEnabled = false
    autoStealToken += 1
    releasePrompt()
    notify("X HUB", "Auto Steal OFF", "Info")
end

AutoStealTab:Toggle({
    Text = "Auto Steal (ProximityPrompt)",
    Description = "Segura o prompt mais próximo",
    Default = false,
    Callback = function(v)
        if v then startAutoSteal() else stopAutoSteal() end
    end,
})

